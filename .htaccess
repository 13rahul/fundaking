# Fundaking Media — production (Hostinger / XAMPP)
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (skip local XAMPP)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --- Crawl hygiene ---
    RewriteRule ^theme-preview(/.*)?$ - [R=404,L]
    RewriteRule ^(automark-astro-main|legacy-php|data|ewebguru-blog|fundedfirm-blog-updates)(/.*)?$ - [R=404,L]

    # /index.php → /
    RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    # /page.php → /page/ (canonical slash URLs) — keep /api/*.php as real endpoints
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteCond %{THE_REQUEST} !\s/+api/ [NC]
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^ /%1/ [R=301,L,NE]

    # Legacy case studies folder → Astro hub
    RewriteRule ^case-studies/?$ /case-study/ [R=301,L]
    RewriteRule ^case-studies/(.+?)/?$ /case-study/$1/ [R=301,L]

    # Retired Automark routes → contact
    RewriteRule ^pricing/?$ /contact/ [R=301,L]
    RewriteRule ^careers(/.*)?$ /contact/ [R=301,L]
    RewriteRule ^features/?$ /seo-consulting-services/ [R=301,L]
    RewriteRule ^integrations/?$ /contact/ [R=301,L]
    RewriteRule ^elements/?$ / [R=301,L]

    # Broken demo blog leftover → AI SEO hub
    RewriteRule ^blog/human-touch-ai-marketing/?$ /blog/what-is-ai-seo-definition-2026/ [R=301,L]

    # Single sitemap only — collapse Astro index/chunk aliases
    RewriteRule ^sitemap-index\.xml$ /sitemap.xml [R=301,L]
    RewriteRule ^sitemap-0\.xml$ /sitemap.xml [R=301,L]

    # Force trailing slash on extensionless URLs (skip files/assets)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !\.[a-z0-9]{1,5}$ [NC]
    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^(.+)$ /$1/ [R=301,L]

    # Directory index without redirect loops: serve folder index
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

    # Extensionless → .php when no static file/dir
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>

# Serve sitemaps as XML (avoid intermittent HTML/500 handlers)
<IfModule mod_mime.c>
    AddType application/xml .xml
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "^sitemap.*\.xml$">
        Header set Content-Type "application/xml; charset=UTF-8"
        Header set Cache-Control "public, max-age=3600"
        Header unset X-Powered-By
    </FilesMatch>
    <FilesMatch "^robots\.txt$">
        Header set Content-Type "text/plain; charset=UTF-8"
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>

    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript font/ttf font/otf font/x-woff image/svg+xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

Options -Indexes

RedirectMatch 403 ^/data/.*$
RedirectMatch 403 ^/legacy-php/.*$

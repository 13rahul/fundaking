---
import Base from "@/layouts/Base.astro";
import PageEnd from "@/layouts/components/PageEnd.astro";
import CaseStudyCard from "@/layouts/components/CaseStudyCard.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { withBase } from "@/lib/paths";
import type { CaseStudy } from "@/types";

const caseStudyList = await getListPage("caseStudy", "-index");
const pageData: CaseStudy = caseStudyList.data;

const caseStudies = await getSinglePage("caseStudy");

const CATEGORY_ORDER = [
  "AI Integration",
  "SEO & Organic Growth",
  "Web & Product",
];

function studyCategory(study: (typeof caseStudies)[number]): string {
  return (
    study.data.category ||
    study.data.badge ||
    "Web & Product"
  );
}

const grouped = CATEGORY_ORDER.map((category) => ({
  category,
  studies: caseStudies.filter((s) => studyCategory(s) === category),
})).filter((g) => g.studies.length > 0);

const other = caseStudies.filter(
  (s) => !CATEGORY_ORDER.includes(studyCategory(s)),
);
if (other.length) {
  grouped.push({ category: "More work", studies: other });
}
---

<Base {...pageData} faqSlug="faq">
  <!-- Page Header -->
  <section class="section-ph pb-20 relative overflow-hidden">
    <div class="container relative">
      <div class="absolute top-0 left-0 w-full">
        <div class="h-100 w-full overflow-hidden -translate-y-10">
          <canvas class="heroSporeCanvas w-full"></canvas>
        </div>
      </div>
      <div class="row justify-center">
        <div class="mb-20 text-center relative">
          <h1
            class="mb-6 lg:col-9 mx-auto text-h3 lg:text-h1 hasHighlight"
            set:html={markdownify(pageData.page_header!.title)}
          />
          <p class="mb-10 lg:col-6 mx-auto text-lg">
            {pageData.page_header!.content}
          </p>
          {
            grouped.length > 1 && (
              <nav
                class="flex flex-wrap justify-center gap-3"
                aria-label="Case study categories"
              >
                {grouped.map((g) => (
                  <a
                    href={`#${g.category.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
                    class="rounded-full border border-white/15 bg-light/40 px-4 py-2 text-sm text-white hover:border-primary hover:bg-primary/20 transition-colors"
                  >
                    {g.category}
                  </a>
                ))}
              </nav>
            )
          }
        </div>
      </div>
    </div>
    <div
      class="absolute left-1/2 top-0 -translate-y-1/2 -translate-x-1/2 size-160 xl:size-300 -z-20 blur-2xl"
      style="background: radial-gradient(circle, var(--color-primary) 0%, color-mix(in srgb, var(--color-primary) 78%, transparent) 20%, transparent 70%);"
    >
    </div>
  </section>
  <hr
    class="h-px bg-linear-to-r from-transparent from-10% via-white/50 to-90% to-transparent border-0"
  />

  {
    grouped.map((group) => (
      <section
        class="section relative"
        id={group.category.toLowerCase().replace(/[^a-z0-9]+/g, "-")}
      >
        <div class="container">
          <div class="section-intro mb-10" data-animate="fade-up">
            <h2 class="title hasHighlight">
              {group.category}
            </h2>
            <p class="subtitle mt-3 max-w-2xl">
              {group.category === "AI Integration" &&
                "CRM systems, AI agents, data pipelines, and automation we built for operations and growth."}
              {group.category === "SEO & Organic Growth" &&
                "Search programmes with measurable organic outcomes for SaaS, fintech, and B2B teams."}
              {group.category === "Web & Product" &&
                "Sites and product marketing builds where structure, UX, and conversion matter."}
              {group.category === "More work" &&
                "Additional engagements across industries."}
            </p>
          </div>
          <div class="grid gap-7 lg:gap-14">
            {group.studies.map((study) => (
              <CaseStudyCard
                href={withBase(`/case-study/${study.id}`)}
                image={study.data.image ?? "/images/case-study-hero-2.png"}
                logo={study.data.logo ?? ""}
                company={study.data.company ?? study.data.title}
                badge={study.data.badge ?? group.category}
                title={study.data.title}
                description={study.data.description}
                stats={study.data.stats}
              />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <PageEnd faqSlug="faq" />
</Base>

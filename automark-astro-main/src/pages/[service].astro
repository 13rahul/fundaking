---
import ServicePage from "@/layouts/ServicePage.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { serviceUrl } from "@/lib/services";

export async function getStaticPaths() {
  const pages = await getSinglePage("services");
  return pages.map((page) => {
    const expected = serviceUrl(page.data.service, page.data.city).slice(1);
    if (page.id !== expected) {
      throw new Error(
        `Service file "${page.id}" must be named "${expected}.md" to match its URL.`,
      );
    }
    return { params: { service: page.id }, props: { page } };
  });
}

const { page } = Astro.props;
---

<ServicePage page={page} />

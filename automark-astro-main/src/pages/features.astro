---
import DynamicIcon from "@/helpers/DynamicIcon";
import Base from "@/layouts/Base.astro";
import BrandsCarousel from "@/layouts/components/BrandsCarousel.astro";
import BusinessNeeds from "@/layouts/components/BusinessNeeds.astro";
import GradientBlob from "@/layouts/components/GradientBlob.astro";
import ImageMod from "@/layouts/components/ImageMod.astro";
import PageEnd from "@/layouts/components/PageEnd.astro";
import ServiceLinkCard from "@/layouts/components/ServiceLinkCard.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { Features } from "@/types";

const features = await getListPage("features", "-index");
const featuresData: Features = features.data;
const specialistPages = featuresData.specialist_pages;
const locationPages = featuresData.location_pages;
---

<Base {...featuresData} faqSlug="faq-features">
  <!-- Banner -->
  <section class="section-ph relative overflow-hidden pb-20">
    <div class="container relative">
      <div class="absolute top-0 left-0 w-full">
        <div class="h-100 w-full overflow-hidden -translate-y-10">
          <canvas class="heroSporeCanvas w-full"></canvas>
        </div>
      </div>
      <div class="row justify-center">
        <div class="relative mb-12 text-center lg:mb-16">
          {
            featuresData.smart_platform?.badge && (
              <p class="badge mb-4">{featuresData.smart_platform.badge}</p>
            )
          }
          <h1
            class="hasHighlight mb-8 text-h3 lg:text-h1 lg:col-9 mx-auto"
            set:html={markdownify(featuresData.banner.title)}
          />
          <p class="mx-auto mb-10 max-w-2xl text-lg">
            {featuresData.banner.content}
          </p>
          <div class="flex flex-wrap items-center justify-center gap-4">
            {
              featuresData.banner.button_primary.enable && (
                <a
                  class="btn btn-primary"
                  href={featuresData.banner.button_primary.link}
                >
                  {featuresData.banner.button_primary.label}
                </a>
              )
            }
            {
              featuresData.banner.button_secondary.enable && (
                <a
                  class="btn btn-outline"
                  href={featuresData.banner.button_secondary.link}
                >
                  {featuresData.banner.button_secondary.label}
                </a>
              )
            }
          </div>
        </div>
        {
          featuresData.banner.image && (
            <div class="col-12">
              <ImageMod
                src={featuresData.banner.image}
                alt="Fundaking SEO consulting services"
                class="w-full"
              />
            </div>
          )
        }
      </div>
    </div>
    <div
      class="absolute left-1/2 top-0 -z-20 size-160 -translate-x-1/2 -translate-y-1/2 blur-2xl xl:size-300"
      style="background: radial-gradient(circle, var(--color-primary) 0%, color-mix(in srgb, var(--color-primary) 78%, transparent) 20%, transparent 70%);"
    >
    </div>
  </section>
  <hr
    class="h-px border-0 bg-linear-to-r from-transparent from-10% via-white/50 to-90% to-transparent"
  />

  <!-- Core service cards -->
  {
    featuresData.smart_platform.enable && (
      <section class="section relative isolate mx-5 overflow-hidden">
        <div class="container">
          <div class="section-container">
            <div class="section-intro centralize">
              {featuresData.smart_platform.badge && (
                <p class="badge mb-4">{featuresData.smart_platform.badge}</p>
              )}
              <h2
                class="title hasHighlight"
                set:html={markdownify(featuresData.smart_platform.title)}
              />
              {featuresData.smart_platform.content && (
                <p class="mt-4 max-w-2xl text-text">
                  {featuresData.smart_platform.content}
                </p>
              )}
            </div>
            <div class="section-content">
              <div class="grid gap-7 md:grid-cols-2 xl:grid-cols-3">
                {featuresData.smart_platform.cards.map((card) =>
                  card.href ? (
                    <ServiceLinkCard
                      title={card.title}
                      description={card.subtitle ?? ""}
                      href={card.href}
                      icon={card.icon}
                      classNames={card.classNames}
                    />
                  ) : null,
                )}
              </div>
            </div>
          </div>
        </div>
        <GradientBlob />
      </section>
    )
  }

  <!-- Specialist pages -->
  {
    specialistPages?.enable && (
      <section class="section-sm relative isolate">
        <div class="container">
          <div class="section-intro centralize mb-10">
            {specialistPages.badge && (
              <p class="badge mb-4">{specialistPages.badge}</p>
            )}
            <h2
              class="title hasHighlight"
              set:html={markdownify(specialistPages.title)}
            />
            {specialistPages.content && (
              <p class="mt-4 max-w-2xl text-text">{specialistPages.content}</p>
            )}
          </div>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {specialistPages.items.map((item) => (
              <ServiceLinkCard
                title={item.title}
                description={item.description}
                href={item.href}
              />
            ))}
          </div>
        </div>
        <GradientBlob />
      </section>
    )
  }

  <!-- Location pages -->
  {
    locationPages?.enable && (
      <section class="section-sm relative isolate pb-16">
        <div class="container">
          <div class="section-intro centralize mb-10">
            {locationPages.badge && (
              <p class="badge mb-4">{locationPages.badge}</p>
            )}
            <h2
              class="title hasHighlight"
              set:html={markdownify(locationPages.title)}
            />
            {locationPages.content && (
              <p class="mt-4 max-w-2xl text-text">{locationPages.content}</p>
            )}
          </div>
          <div class="space-y-8">
            {locationPages.groups.map((group) => (
              <div class="text-center">
                <p class="mb-4 text-sm font-semibold uppercase tracking-wide text-white">
                  {group.label}
                </p>
                <div class="flex flex-wrap justify-center gap-3">
                  {group.items.map((item) => (
                    <a
                      href={item.href}
                      class="rounded-full border border-border/60 bg-white/5 px-5 py-2.5 text-sm text-text transition-colors hover:border-primary/50 hover:text-white"
                    >
                      {item.title}
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- How we work + landing page links -->
  {
    featuresData.service_features.enable &&
      featuresData.service_features.items.map((feature, index) => (
        <section class="section-sm relative isolate">
          <div class="container">
            <div class="overflow-hidden rounded-3xl bg-light/6">
              <div
                class:list={[
                  "grid lg:grid-cols-2",
                  !feature.image && "lg:grid-cols-1",
                ]}
              >
                <div
                  class:list={[
                    "p-8 lg:p-12 xl:p-14",
                    feature.reverse && feature.image && "lg:order-1",
                  ]}
                >
                  <h2
                    class="hasHighlight mb-9 text-h3-sm font-bold lg:mb-12 lg:text-h2"
                    set:html={markdownify(feature.title)}
                  />

                  <div class="grid gap-8 sm:grid-cols-2 lg:gap-10">
                    {feature.items.map((item) => {
                      const inner = (
                        <>
                          <div class="mb-4 grid size-10 place-items-center rounded-xl border border-border bg-white/6">
                            <DynamicIcon
                              icon={item.icon}
                              className="text-lg text-text-light"
                            />
                          </div>
                          <h3 class="mb-2 text-h5-sm font-bold text-white">
                            {item.title}
                          </h3>
                          <p class="text-text">{item.content}</p>
                          {item.href && (
                            <span class="mt-2 inline-block text-sm text-primary">
                              Read more →
                            </span>
                          )}
                        </>
                      );
                      return item.href ? (
                        <a
                          href={item.href}
                          class="block rounded-xl transition-colors hover:bg-white/5"
                        >
                          {inner}
                        </a>
                      ) : (
                        <article>{inner}</article>
                      );
                    })}
                  </div>
                </div>

                {feature.image && (
                  <div
                    class:list={[
                      "h-max bg-white/2 p-8 lg:p-12 xl:p-14",
                      feature.reverse ? "" : "lg:order-0",
                    ]}
                  >
                    <ImageMod
                      src={feature.image}
                      alt={feature.title}
                      class="w-full object-contain"
                    />
                  </div>
                )}
              </div>
            </div>
          </div>
          {index === 0 && <GradientBlob />}
        </section>
      ))
  }

  <BrandsCarousel />

  <BusinessNeeds />

  <PageEnd faqSlug="faq-features" />
</Base>

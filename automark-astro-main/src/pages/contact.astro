---
import Base from "@/layouts/Base.astro";
import PageEnd from "@/layouts/components/PageEnd.astro";
import PageHeader from "@/layouts/components/PageHeader.astro";
import { getListPage } from "@/lib/contentParser.astro";
import DynamicIcon from "@/helpers/DynamicIcon";
import type { Contact } from "@/types";
import config from "@/config/config.json";

const contact = await getListPage("contact", "-index");
const contactData: Contact = contact.data;
const whatsappUrl =
  config.params.whatsapp_url ||
  "https://wa.me/918421053710?text=Hi%20Rahul%2C%20I%20want%20to%20book%20a%20free%20SEO%20audit";
const formAction = config.params.contact_form_action || "/api/contact.php";
const notifyEmail =
  config.params.lead_notify_email ||
  config.params.footer_email ||
  "13rahulagarwal@gmail.com";
---

<Base {...contactData} faqSlug="faq">
  <PageHeader
    title={contactData.page_header!.title}
    subtitle={contactData.page_header!.subtitle}
  />

  <!-- Contact Section -->
  <section class="section pt-0">
    <div class="container">
      <div class="row g-7 max-lg:gap-5">
        <!-- Left Column - Contact Cards -->
        <div class="col-12 lg:col-5">
          <div class="flex flex-col gap-5">
            {
              contactData.contact_info?.enable &&
                contactData.contact_info.items.map((item) => {
                  const isExternal =
                    !!item.link &&
                    (item.link.startsWith("http") ||
                      item.link.startsWith("mailto:") ||
                      item.link.startsWith("tel:"));
                  return (
                    <a
                      href={item.link || whatsappUrl}
                      target={isExternal && item.link?.startsWith("http") ? "_blank" : undefined}
                      rel={
                        isExternal && item.link?.startsWith("http")
                          ? "noopener noreferrer"
                          : undefined
                      }
                      class="flex flex-col gap-5 p-7 md:p-8 bg-white/5 rounded-2xl cursor-pointer hover:bg-white/10 transition-all duration-300 ring-1 ring-white/10 hover:ring-primary/50 group hover:scale-[1.02]"
                    >
                      <div class="w-10 h-10 flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
                        <DynamicIcon
                          icon={item.icon ?? ""}
                          className="w-10 h-10 text-white"
                        />
                      </div>
                      <div class="flex flex-col gap-3">
                        <h3 class="font-secondary font-bold text-2xl text-white">
                          {item.title}
                        </h3>
                        <p class="text-text text-lg">{item.detail}</p>
                      </div>
                    </a>
                  );
                })
            }
          </div>
        </div>

        <!-- Right Column - Contact form -->
        <div class="col-12 lg:col-7">
          <div class="p-8 md:p-10 bg-white/5 rounded-2xl ring-1 ring-white/10 h-full">
            <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-primary">
              Send a message
            </p>
            <h2 class="font-secondary font-bold text-3xl text-white mb-4">
              Book your free SEO audit
            </h2>
            <p class="text-text text-lg mb-8">
              Submissions go to <strong class="text-white">{notifyEmail}</strong>.
              Prefer WhatsApp?
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary underline underline-offset-4"
              >
                +91 84210 53710
              </a>
            </p>

            <form
              id="fk-contact-form"
              class="space-y-5"
              action={formAction}
              method="POST"
              novalidate
            >
              <input type="hidden" name="source" value="contact" />
              <!-- Honeypot -->
              <input
                type="text"
                name="website"
                tabindex="-1"
                autocomplete="off"
                class="hidden"
                aria-hidden="true"
              />
              <div>
                <label class="sr-only" for="fk-name">Name</label>
                <input
                  id="fk-name"
                  type="text"
                  name="name"
                  placeholder="Your name"
                  class="form-input w-full"
                  required
                />
              </div>
              <div>
                <label class="sr-only" for="fk-email">Email</label>
                <input
                  id="fk-email"
                  type="email"
                  name="email"
                  placeholder="Work email"
                  class="form-input w-full"
                  required
                />
              </div>
              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label class="sr-only" for="fk-phone">Phone</label>
                  <input
                    id="fk-phone"
                    type="tel"
                    name="phone"
                    placeholder="Phone / WhatsApp"
                    class="form-input w-full"
                  />
                </div>
                <div>
                  <label class="sr-only" for="fk-site">Website</label>
                  <input
                    id="fk-site"
                    type="url"
                    name="site"
                    placeholder="Website URL"
                    class="form-input w-full"
                  />
                </div>
              </div>
              <div>
                <label class="sr-only" for="fk-message">Message</label>
                <textarea
                  id="fk-message"
                  name="message"
                  rows="4"
                  placeholder="Goals, timeline, or what you want audited"
                  class="form-input rounded-4xl! w-full resize-none"
                  required></textarea>
              </div>
              <button
                type="submit"
                id="fk-contact-submit"
                class="btn btn-primary w-full py-4 text-lg font-medium"
              >
                Send enquiry
              </button>
              <p
                id="fk-contact-status"
                class="text-sm text-text min-h-5"
                role="status"
                aria-live="polite"></p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Google Business Profile map -->
  <section class="section pt-0" aria-labelledby="gbp-map-heading">
    <div class="container">
      <div class="mb-8 max-w-3xl">
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-primary">
          Google Business Profile
        </p>
        <h2 id="gbp-map-heading" class="title hasHighlight mb-4">
          Find <strong>Fundaking Media</strong> on Google Maps
        </h2>
        <p class="text-text text-lg mb-5">
          Visit our Google Business Profile for directions, reviews, and office
          details — Fundaking Media (Rahul Agarwal), Pandare, Baramati, Pune.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="https://www.google.com/maps?cid=2623935863145284685"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
          >
            Open Google Business Profile
          </a>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            Book audit on WhatsApp
          </a>
        </div>
      </div>
      <div
        class="overflow-hidden rounded-2xl ring-1 ring-white/10 bg-white/5 shadow-lg"
      >
        <iframe
          title="Fundaking Media — Rahul Agarwal on Google Maps"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12569241.415091315!2d82.75252935!3d21.0680074!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bc3a78b97137889%3A0x2464feeefb15a44d!2sFundaking%20Media%20-%20Rahul%20Agarwal!5e1!3m2!1sen!2sin!4v1793014951913!5m2!1sen!2sin"
          width="600"
          height="450"
          style="border:0;width:100%;min-height:450px;display:block"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
    </div>
  </section>

  <PageEnd />
</Base>

<script>
  const form = document.getElementById("fk-contact-form") as HTMLFormElement | null;
  if (form) {
    const status = document.getElementById("fk-contact-status");
    const btn = document.getElementById("fk-contact-submit") as HTMLButtonElement | null;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!status || !btn) return;
      status.textContent = "Sending…";
      status.className = "text-sm text-text min-h-5";
      btn.disabled = true;
      try {
        const data = Object.fromEntries(new FormData(form).entries());
        const res = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(data),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.ok) {
          throw new Error(json.error || "Send failed");
        }
        status.textContent = "Sent — Rahul will reply soon.";
        status.className = "text-sm text-primary min-h-5";
        form.reset();
      } catch (err) {
        status.textContent =
          err instanceof Error
            ? err.message
            : "Could not send. WhatsApp +91 84210 53710 instead.";
        status.className = "text-sm text-red-400 min-h-5";
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>

---
import Base from "@/layouts/Base.astro";
import BrandsCarousel from "@/layouts/components/BrandsCarousel.astro";
import PageEnd from "@/layouts/components/PageEnd.astro";
import GradientBlob from "@/layouts/components/GradientBlob.astro";
import ImageMod from "@/layouts/components/ImageMod.astro";
import OurStory from "@/layouts/components/OurStory.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { withBase } from "@/lib/paths";
import {
  absoluteUrl,
  faqPageNode,
  pageGraph,
} from "@/lib/schema";
import { markdownify } from "@/lib/utils/textConverter";
import Features from "@/partials/Features.astro";
import Testimonial from "@/partials/Testimonial.astro";
import config from "@/config/config.json";
import type { About } from "@/types";

const about = await getListPage("about", "-index");
const aboutData: About = about.data;
const wa =
  config.params.whatsapp_url ||
  "https://wa.me/918421053710?text=Hi%20Rahul%2C%20I%20want%20to%20book%20a%20free%20SEO%20audit";

const homeFaq = await getListPage("faqSection", "faq");
const faqItems =
  homeFaq.data.enable && homeFaq.data.items?.length ? homeFaq.data.items : [];

const aboutUrl = absoluteUrl("/about");
const aboutSchema = pageGraph({
  name: aboutData.meta_title || "About Rahul Agarwal | Fundaking Media",
  description: aboutData.description || "",
  url: aboutUrl,
  pageType: "AboutPage",
  extra: [
    {
      "@type": "Person",
      "@id": `${absoluteUrl("/")}/#founder-about`,
      name: "Rahul Agarwal",
      alternateName: "Rahul Vijay Agarwal",
      jobTitle: "Founder & SEO Consultant",
      worksFor: { "@id": `${absoluteUrl("/")}/#organization` },
      url: aboutUrl,
      image: absoluteUrl("/images/author/rahul-agarwal.png"),
      sameAs: [
        "https://www.linkedin.com/in/rahul-agarwal-510a5b79/",
        aboutUrl,
      ],
      address: {
        "@type": "PostalAddress",
        addressLocality: "Baramati",
        addressRegion: "Maharashtra",
        postalCode: "413110",
        addressCountry: "IN",
      },
      knowsAbout: [
        "Technical SEO",
        "Local SEO",
        "SEO consulting",
        "Content architecture",
        "LLM SEO",
      ],
    },
    ...(faqItems.length ? [faqPageNode(faqItems, aboutUrl)] : []),
  ],
});

const header = aboutData.page_header as typeof aboutData.page_header & {
  primary_cta?: { label: string; link: string };
  secondary_cta?: { label: string; link: string };
};
const who = (aboutData as any).who_i_help;
const process = (aboutData as any).process;
const proof = (aboutData as any).proof;
const servicesLinks = (aboutData as any).services_links;
const credentials = (aboutData as any).credentials;
---

<Base
  {...aboutData}
  faqSlug="faq"
  canonical={aboutUrl}
  jsonLd={aboutSchema}
>
  <!-- Hero: brand + conversion -->
  <section class="section-ph section-ph--compact relative overflow-hidden">
    <div class="container relative z-10">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <div class="lg:col-span-7" data-animate="fade-up">
          <p class="text-primary-light font-semibold mb-4 tracking-wide">
            About · Fundaking Media · Pune
          </p>
          <h1
            class="hasHighlight mb-6 text-left"
            set:html={markdownify(header.title)}
          />
          <p class="text-lg text-text max-w-2xl mb-8">{header.subtitle}</p>
          <div class="flex flex-wrap gap-3">
            <a
              href={header.primary_cta?.link || wa}
              class="btn btn-primary"
              target="_blank"
              rel="noopener noreferrer"
            >
              {header.primary_cta?.label || "Book free SEO audit on WhatsApp"}
            </a>
            <a
              href={withBase(header.secondary_cta?.link || "/case-study/")}
              class="btn btn-outline"
            >
              {header.secondary_cta?.label || "See case studies"}
            </a>
          </div>
          <p class="mt-6 text-sm text-text/80">
            Also explore{" "}
            <a class="underline hover:text-white" href={withBase("/seo-consulting-pune/")}>SEO consulting Pune</a>
            {" · "}
            <a class="underline hover:text-white" href={withBase("/technical-seo-consultant/")}>Technical SEO</a>
            {" · "}
            <a class="underline hover:text-white" href={withBase("/blog/")}>Blog</a>
          </p>
        </div>
        <div class="lg:col-span-5" data-animate="fade-up">
          <div class="relative mx-auto max-w-md">
            <div class="absolute -inset-4 rounded-[2rem] bg-primary/20 blur-2xl -z-10"></div>
            <ImageMod
              src={header.image}
              alt="Rahul Agarwal — SEO consultant in Pune, Fundaking Media"
              width={640}
              height={800}
              class="w-full rounded-[1.75rem] object-cover aspect-[4/5] border border-white/10"
              loading="eager"
            />
            <div class="mt-4 rounded-2xl bg-light/80 border border-white/10 px-5 py-4">
              <p class="text-white font-semibold">Rahul Agarwal</p>
              <p class="text-sm text-text">
                Founder · SEO consultant · Fundaking Media OPC Pvt Ltd
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="absolute inset-0 -z-10 overflow-hidden opacity-60">
      <canvas class="heroSporeCanvas w-full"></canvas>
    </div>
  </section>

  <BrandsCarousel />

  {
    aboutData.stats?.enable && (
      <section class="section pt-10 pb-6 relative" aria-label="Key stats">
        <div class="container">
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-3" data-animate-stagger>
            {aboutData.stats.items.map((stat: any) => (
              <div class="text-center px-4 py-8 rounded-2xl bg-primary/10 border border-white/5">
                <div class="text-h3 lg:text-h2 leading-none font-bold font-secondary text-white mb-2">
                  {stat.value}
                </div>
                <p class="text-text text-sm lg:text-base">{stat.label}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    who?.enable && (
      <section class="section relative" id="who-i-help">
        <div class="container">
          <div class="section-intro centralize max-w-3xl mx-auto" data-animate="fade-up">
            <h2 class="title hasHighlight" set:html={markdownify(who.title)} />
            {who.subtitle && <p class="subtitle mt-4">{who.subtitle}</p>}
          </div>
          <div class="grid sm:grid-cols-2 gap-5 mt-12" data-animate-stagger>
            {who.items.map((item: any) => (
              <div class="rounded-2xl bg-light/60 border border-white/10 p-7 lg:p-8">
                <h3 class="text-white text-xl font-semibold mb-3">{item.title}</h3>
                <p class="text-text leading-relaxed">{item.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <OurStory />

  {
    process?.enable && (
      <section class="section relative" id="process">
        <div class="container">
          <div class="section-intro centralize max-w-3xl mx-auto" data-animate="fade-up">
            <h2 class="title hasHighlight" set:html={markdownify(process.title)} />
            {process.subtitle && <p class="subtitle mt-4">{process.subtitle}</p>}
          </div>
          <div class="grid md:grid-cols-3 gap-5 mt-12" data-animate-stagger>
            {process.steps.map((step: any) => (
              <div class="rounded-2xl border border-white/10 bg-body p-7 relative overflow-hidden">
                <span class="text-primary-light/40 font-secondary text-5xl font-bold absolute top-3 right-4">
                  {step.num}
                </span>
                <h3 class="text-white text-xl font-semibold mb-3 relative z-10">
                  {step.title}
                </h3>
                <p class="text-text relative z-10 leading-relaxed">{step.text}</p>
              </div>
            ))}
          </div>
          <div class="mt-10 text-center">
            <a href={wa} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
              Start with a free strategy call
            </a>
          </div>
        </div>
        <GradientBlob />
      </section>
    )
  }

  {
    proof?.enable && (
      <section class="section relative" id="proof">
        <div class="container">
          <div class="section-intro centralize max-w-3xl mx-auto" data-animate="fade-up">
            <h2 class="title hasHighlight" set:html={markdownify(proof.title)} />
            {proof.subtitle && <p class="subtitle mt-4">{proof.subtitle}</p>}
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-12" data-animate-stagger>
            {proof.items.map((item: any) => (
              <a
                href={withBase(item.link)}
                class="group rounded-2xl bg-light/70 border border-white/10 p-6 hover:border-primary/50 transition-colors block h-full"
              >
                <h3 class="text-white font-semibold text-lg mb-2 group-hover:text-primary-light">
                  {item.title}
                </h3>
                <p class="text-text text-sm leading-relaxed mb-4">{item.text}</p>
                <span class="text-sm text-primary-light">View case study →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    aboutData.core_values?.enable && (
      <Features
        our_features={{
          ...aboutData.core_values,
          content:
            (aboutData.core_values as any).content ||
            aboutData.core_values.subtitle,
        }}
      />
    )
  }

  {
    servicesLinks?.enable && (
      <section class="section relative" id="services">
        <div class="container">
          <div class="section-intro centralize" data-animate="fade-up">
            <h2
              class="title hasHighlight"
              set:html={markdownify(servicesLinks.title)}
            />
          </div>
          <div class="flex flex-wrap justify-center gap-3 mt-10" data-animate-stagger>
            {servicesLinks.items.map((item: any) => (
              <a
                href={withBase(item.href)}
                class="rounded-full border border-white/15 bg-light/40 px-5 py-2.5 text-white hover:border-primary hover:bg-primary/20 transition-colors"
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    credentials?.enable && (
      <section class="section relative" id="credentials">
        <div class="container max-w-4xl">
          <div class="section-intro centralize" data-animate="fade-up">
            <h2
              class="title hasHighlight"
              set:html={markdownify(credentials.title)}
            />
          </div>
          <dl class="mt-10 rounded-2xl border border-white/10 bg-light/50 divide-y divide-white/10">
            {credentials.items.map((row: any) => (
              <div class="grid sm:grid-cols-3 gap-2 px-6 py-4">
                <dt class="text-text text-sm uppercase tracking-wide">
                  {row.label}
                </dt>
                <dd class="sm:col-span-2 text-white">
                  {row.link ? (
                    <a
                      href={row.link}
                      class="underline hover:text-primary-light"
                      target={row.link.startsWith("http") ? "_blank" : undefined}
                      rel={
                        row.link.startsWith("http")
                          ? "noopener noreferrer"
                          : undefined
                      }
                    >
                      {row.value}
                    </a>
                  ) : (
                    row.value
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )
  }

  <Testimonial />

  <!-- Mid conversion band -->
  <section class="section pt-6">
    <div class="container">
      <div class="rounded-3xl border border-primary/30 bg-primary/15 px-8 py-12 lg:px-14 text-center">
        <h2 class="text-h4 lg:text-h3 text-white mb-4">
          Ready for Google to bring real enquiries?
        </h2>
        <p class="text-text max-w-2xl mx-auto mb-8">
          Message Rahul on WhatsApp for a free SEO audit — what to fix first,
          clear next steps, no lock-in pitch.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href={wa} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
            WhatsApp +91 84210 53710
          </a>
          <a href={withBase("/contact/")} class="btn btn-outline">Contact page</a>
        </div>
      </div>
    </div>
  </section>

  <PageEnd />
</Base>

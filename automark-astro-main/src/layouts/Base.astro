---
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Preloader from "@/layouts/components/Preloader.astro";
import SchemaJsonLd from "@/layouts/components/SchemaJsonLd.astro";
import { withBase } from "@/lib/paths";
import { getListPage } from "@/lib/contentParser.astro";
import {
  absoluteUrl,
  autoBreadcrumbItems,
  breadcrumbList,
  faqPageNode,
  graphHasType,
  mergeGraph,
  pageGraph,
  pathFromAstroPathname,
  webPageTypeForPath,
} from "@/lib/schema";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import { Font } from "astro:assets";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";

const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Matches PageEnd FAQ section — emits FAQPage JSON-LD when enabled. */
  faqSlug?: string;
  ogType?: string;
  publishedTime?: string;
  modifiedTime?: string;
  articleAuthorName?: string;
  articleAuthorUrl?: string;
}

const {
  title,
  meta_title,
  description,
  image,
  noindex,
  canonical,
  jsonLd,
  faqSlug,
  ogType = "website",
  publishedTime,
  modifiedTime,
  articleAuthorName,
  articleAuthorUrl,
} = Astro.props;

const gscVerification =
  "google_site_verification" in config
    ? String((config as { google_site_verification?: string }).google_site_verification ?? "").trim()
    : "";
const gtmEnabled =
  config.google_tag_manager.enable &&
  String(config.google_tag_manager.gtm_id ?? "").trim().length > 0;

const pageTitle = plainify(
  meta_title ? meta_title : title ? title : config.site.title,
);
const pageDesc = plainify(
  description ? description : config.metadata.meta_description,
);
const pagePath = pathFromAstroPathname(Astro.url.pathname);
const pageUrl = canonical ?? absoluteUrl(pagePath);
const defaultSchema = pageGraph({
  name: pageTitle,
  description: pageDesc,
  url: pageUrl,
  pageType: webPageTypeForPath(pagePath),
});

const schemaExtras: Record<string, unknown>[] = [];

if (pagePath !== "/" && !graphHasType(jsonLd ?? defaultSchema, "BreadcrumbList")) {
  const crumbs = autoBreadcrumbItems(pagePath);
  if (crumbs.length > 1) {
    schemaExtras.push(breadcrumbList(crumbs));
  }
}

if (faqSlug && !graphHasType(jsonLd ?? defaultSchema, "FAQPage")) {
  try {
    const faqEntry = await getListPage("faqSection", faqSlug);
    if (faqEntry.data.enable && faqEntry.data.items?.length) {
      schemaExtras.push(faqPageNode(faqEntry.data.items, pageUrl));
    }
  } catch {
    /* optional FAQ section */
  }
}

let schemaPayload = jsonLd ?? defaultSchema;
if (schemaExtras.length) {
  schemaPayload = mergeGraph(schemaPayload, schemaExtras);
}
---

<!doctype html>
<html lang="en" data-base-path={import.meta.env.BASE_URL}>
  <head>
    <!-- google tag manager -->
    {gtmEnabled && <GoogleTagmanager id={config.google_tag_manager.gtm_id} />}
    {gscVerification && (
      <meta name="google-site-verification" content={gscVerification} />
    )}
    <link rel="icon" href={withBase(config.site.favicon)} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase("/images/og-image.png")} />
    <meta name="application-name" content="Fundaking Media" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    <link rel="canonical" href={pageUrl} />
    <link
      rel="alternate"
      type="text/plain"
      href={absoluteUrl("/llms.txt")}
      title="LLM site summary"
    />
    <SchemaJsonLd data={schemaPayload} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta
      name="description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <!-- View Transitions removed to avoid conflicts with GSAP/Lenis/Swiper -->

    <meta name="author" content={config.metadata.meta_author} />
    <meta
      property="og:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />
    <meta
      property="og:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageUrl} />
    {
      ogType === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      ogType === "article" && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    {
      ogType === "article" && articleAuthorName && (
        <meta property="article:author" content={articleAuthorName} />
      )
    }
    {
      ogType === "article" && articleAuthorUrl && (
        <link rel="author" href={articleAuthorUrl} />
      )
    }
    <meta
      name="twitter:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />
    <meta
      name="twitter:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta
      property="og:image"
      content={absoluteUrl(image ? image : config.metadata.meta_image)}
    />
    <meta
      name="twitter:image"
      content={absoluteUrl(image ? image : config.metadata.meta_image)}
    />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- GSAP CDN -->
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/gsap.min.js"></script>
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/ScrollTrigger.min.js"
    ></script>

    <!-- LENIS CDN -->
    <script
      is:inline
      defer
      src="https://unpkg.com/lenis@1.3.17/dist/lenis.min.js"></script>

    <!-- Main UI interactions -->
    <script is:inline defer src={withBase("/scripts/main.js")}></script>

    <!-- Animations (Modules are deferred automatically by browsers) -->
    <script is:inline type="module" src={withBase("/scripts/animations.js")}></script>
  </head>
  <body>
    {/* google tag manager noscript */}
    {
      gtmEnabled && (
        <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />
      )
    }

    {/* <TwSizeIndicator /> */}
    <Preloader />
    <Header />
    <main id="main-content" class="overflow-x-hidden md:overflow-x-auto">
      <slot />
    </main>
    <Footer />
  </body>
</html>

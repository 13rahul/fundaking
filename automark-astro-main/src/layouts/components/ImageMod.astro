---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  loading?: "eager" | "lazy" | null | undefined;
  decoding?: "async" | "auto" | "sync" | null | undefined;
  format?: "auto" | "avif" | "jpeg" | "png" | "svg" | "webp";
  fit?: "cover" | "contain" | "fill" | "none" | "scale-down";
  class?: string;
  style?: any;
}

let {
  src,
  alt,
  width,
  height,
  loading,
  decoding,
  class: className,
  format,
  style,
  fit,
} = Astro.props;

// Keep the public URL for direct <img> (SVGs must not go through /_astro hashing —
// those hashed files are often missing on deploy and break featured images).
const publicSrc = src.startsWith("/") ? src : `/${src}`;
const isSvg = /\.svg($|\?)/i.test(publicSrc);

const globKey = `/public${publicSrc}`;
const images = import.meta.glob("/public/images/**/*.{jpeg,jpg,png,gif,svg}");
const isValidPath = Boolean(images[globKey]);

!isValidPath &&
  console.error(
    `\x1b[31mImage not found - ${globKey}.\x1b[0m Make sure the image is in the /public/images folder.`,
  );
---

{
  isValidPath && isSvg && (
    <img
      src={publicSrc}
      alt={alt}
      width={width}
      height={height}
      loading={loading ?? "lazy"}
      decoding={decoding ?? "async"}
      class={className}
      style={style}
    />
  )
}
{
  isValidPath && !isSvg && (
    <Image
      src={images[globKey]() as Promise<{ default: ImageMetadata }>}
      alt={alt}
      width={width as any}
      height={height as any}
      loading={loading}
      fit={fit ? fit : "contain"}
      decoding={decoding}
      class={className}
      format={format}
      style={style}
    />
  )
}

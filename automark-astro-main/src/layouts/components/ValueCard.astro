---
import ImageMod from "@/layouts/components/ImageMod.astro";
import { withBase } from "@/lib/paths";
interface Props {
  logo: string;
  title: string;
  list?: string[];
  href?: string;
}
const { logo, title, list, href } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag
  href={href ? withBase(href) : undefined}
  class:list={[
    "block p-8 rounded-2xl bg-white/5",
    href && "group transition-colors hover:bg-white/8",
  ]}
>
  <ImageMod src={logo} alt={`${title} icon`} class="mb-6" />
  <h3 class:list={["text-h5-sm font-bold", href && "group-hover:text-primary"]}>
    {title}
  </h3>
  <ul class="stars-list mt-5 text-text-dark">
    {list?.map((item) => <li>{item}</li>)}
  </ul>
  {
    href && (
      <span class="mt-6 inline-block text-sm font-medium text-primary">
        Explore service →
      </span>
    )
  }
</Tag>

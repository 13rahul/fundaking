---
import ImageMod from "@/layouts/components/ImageMod.astro";
import { markdownify } from "@/lib/utils/textConverter";
import config from "@/config/config.json";

interface Props {
  lead_generation: any;
}

const { lead_generation } = Astro.props;
const whatsappUrl =
  lead_generation.button?.link?.startsWith("http")
    ? lead_generation.button.link
    : config.params.whatsapp_url ||
      "https://wa.me/918421053710?text=Hi%20Rahul%2C%20I%20want%20to%20book%20a%20free%20SEO%20audit";
const buttonLabel =
  lead_generation.button?.label || "Book free SEO audit on WhatsApp";
---

<section class="section-box bg-transparent my-0 pb-0">
  <div class="container-sm">
    <div class="section-container pb-20">
      <div class="section-intro centralize" data-animate="fade-up">
        <h2
          class="title hasHighlight  "
          set:html={lead_generation.title}
        />
      </div>
      <div class="section-content">
        <div
          class="flex flex-col-reverse lg:flex-row gap-x-20 gap-y-10"
          data-animate-stagger
        >
          <div class="lg:w-6/12">
            <h3 class="text-h5-sm font-bold mb-7">
              {lead_generation.subtitle}
            </h3>
            <div
              class="space-y-4"
              set:html={markdownify(lead_generation.content, true)}
            />
            <ul class="green-tick-list [&>li]:mb-6 sm:[&>li]:mb-8 mt-6 sm:mt-10">
              {lead_generation.list.map((item: string) => (
                <li set:html={markdownify(item)} />
              ))}
            </ul>
          </div>
          <div class="lg:w-6/12">
            <div class="bg-light rounded-4xl corner-squircle p-10 xl:px-7.5 xl:py-10 text-center">
              <ImageMod
                src={lead_generation.image}
                width={307}
                height={190}
                alt="ebook"
                class="w-full max-w-76.75 mx-auto mb-12"
              />
              <p class="text-text mb-6 text-left">
                Message Rahul on WhatsApp at
                <strong class="text-white"> +91 84210 53710</strong> — share your
                site URL and goals for a free SEO audit.
              </p>
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary w-full"
              >
                {buttonLabel}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <hr class="h-px bg-linear-to-r from-transparent from-10% via-white/50 to-90% to-transparent border-0" />
</section>

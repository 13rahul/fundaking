---
import config from "@/config/config.json";
---

<div
  class="bg-white/5 rounded-2xl p-8 xl:py-10 border border-border/50 backdrop-blur-sm sticky top-26"
>
  <h3 class="text-h4 font-bold text-white mb-8">Apply for position</h3>

  <form
    id="fk-apply-form"
    class="space-y-5"
    action={config.params.apply_form_action}
    method="POST"
  >
    <input type="hidden" name="source" value="careers" />
    <input
      type="text"
      name="website"
      tabindex="-1"
      autocomplete="off"
      class="hidden"
      aria-hidden="true"
    />

    <div>
      <input
        type="text"
        placeholder="Name"
        class="form-input w-full"
        required
        name="name"
      />
    </div>

    <div>
      <input
        type="email"
        placeholder="Email Address"
        class="form-input w-full"
        required
        name="email"
      />
    </div>

    <div>
      <textarea
        placeholder="Why are you applying? (include LinkedIn / CV link)"
        class="form-input rounded-4xl! w-full resize-none"
        rows="4"
        required
        name="message"></textarea>
    </div>

    <button type="submit" id="fk-apply-submit" class="btn btn-primary w-full"
      >Apply Now</button
    >
    <p id="fk-apply-status" class="text-sm text-text min-h-5" role="status"></p>
  </form>
</div>

<script>
  const form = document.getElementById("fk-apply-form") as HTMLFormElement | null;
  if (form) {
    const status = document.getElementById("fk-apply-status");
    const btn = document.getElementById("fk-apply-submit") as HTMLButtonElement | null;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!status || !btn) return;
      status.textContent = "Sending…";
      btn.disabled = true;
      try {
        const data = Object.fromEntries(new FormData(form).entries());
        const res = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(data),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.ok) throw new Error(json.error || "Send failed");
        status.textContent = "Application sent — thank you.";
        form.reset();
      } catch (err) {
        status.textContent =
          err instanceof Error ? err.message : "Could not send. Email 13rahulagarwal@gmail.com.";
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>

---
import config from "@/config/config.json";
import { withBase } from "@/lib/paths";

const { src }: { src?: string } = Astro.props;
const {
  logo,
  logo_width,
  logo_height,
  logo_text,
  title,
}: {
  logo: string;
  logo_width: any;
  logo_height: any;
  logo_text: string;
  title: string;
} = config.site;

/** Prefer PNG for Hostinger (SVG text + Astro webp transform was blank). */
const logoSrc = src || logo || "/images/logo.png";
const w = Number(String(logo_width).replace("px", "")) || 176;
const h = Number(String(logo_height).replace("px", "")) || 48;
---

<a href={withBase("/")} class="navbar-brand inline-block">
  {
    logoSrc ? (
      <img
        src={withBase(logoSrc)}
        class="inline-block"
        width={w}
        height={h}
        alt={title || "Fundaking Media"}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        style={`height:${h}px;width:auto;max-width:${w}px`}
      />
    ) : logo_text ? (
      logo_text
    ) : (
      title
    )
  }
</a>

---
import { getListPage } from "@/lib/contentParser.astro";
import type { TestimonialSection } from "@/types";

const testimonialEntry = await getListPage("testimonialSection", "testimonial");
const data: TestimonialSection = testimonialEntry.data;

const reviews = data.testimonials ?? [];
const ratingValue = data.rating_value ?? "5.0";
const reviewCount = data.review_count ?? reviews.length;
const writeUrl =
  data.write_review_url ?? "https://g.page/r/CU2kFfvu_mQkEAE/review";
const mapsUrl = data.google_maps_url ?? writeUrl;

function initials(name: string) {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((p) => p[0]?.toUpperCase() ?? "")
    .join("");
}

function stars(n: number) {
  return "★".repeat(Math.max(1, Math.min(5, n || 5)));
}
---

{
  data.enable && (
    <section
      id="google-reviews"
      class="section relative overflow-hidden"
      aria-labelledby="google-reviews-heading"
    >
      <div class="container">
        <div class="section-container">
          <div
            class="section-intro centralize max-w-3xl mx-auto"
            data-animate="fade-up"
          >
            <div class="inline-flex items-center gap-2 rounded-full bg-white/5 px-3 py-1.5 text-sm text-text mb-5">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  fill="#4285F4"
                  d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                ></path>
                <path
                  fill="#34A853"
                  d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                ></path>
                <path
                  fill="#FBBC05"
                  d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                ></path>
                <path
                  fill="#EA4335"
                  d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                ></path>
              </svg>
              <span>Google reviews</span>
              <span class="text-amber-400 font-semibold" aria-label={`${ratingValue} out of 5`}>
                {ratingValue} {stars(5)}
              </span>
              <span class="opacity-70">({reviewCount})</span>
            </div>
            <h2
              id="google-reviews-heading"
              class="title hasHighlight"
              set:html={data.title}
            />
            {
              data.subtitle && (
                <p class="mt-4 text-text text-lg">{data.subtitle}</p>
              )
            }
            <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
              <a
                href={writeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary"
              >
                {data.write_review_label ?? "Write a Google review"}
              </a>
              <a
                href={mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-outline"
              >
                View on Google Maps
              </a>
            </div>
          </div>

          <div class="section-content mt-10" data-animate="fade-up">
            <div
              class="google-reviews-scroller flex gap-5 overflow-x-auto pb-4 snap-x snap-mandatory scroll-smooth"
              role="list"
              aria-label="Google customer reviews"
            >
              {
                reviews.map((item) => {
                  const href =
                    item.google_url ||
                    mapsUrl;
                  const rating = item.rating ?? 5;
                  return (
                    <article
                      role="listitem"
                      class="google-review-card snap-start shrink-0 w-[min(100%,320px)] rounded-2xl bg-light/70 border border-white/10 p-6 flex flex-col"
                      itemscope
                      itemtype="https://schema.org/Review"
                    >
                      <meta itemprop="itemReviewed" content="Fundaking Media" />
                      <div class="flex items-start justify-between gap-3 mb-4">
                        <div class="flex items-center gap-3 min-w-0">
                          <div
                            class="size-11 shrink-0 rounded-full bg-primary/25 text-white grid place-items-center font-semibold text-sm"
                            aria-hidden="true"
                          >
                            {initials(item.name)}
                          </div>
                          <div class="min-w-0">
                            <a
                              href={href}
                              target="_blank"
                              rel="noopener noreferrer me"
                              class="font-semibold text-white hover:underline truncate block"
                              itemprop="author"
                              itemscope
                              itemtype="https://schema.org/Person"
                            >
                              <span itemprop="name">{item.name}</span>
                            </a>
                            <p class="text-sm text-text truncate">
                              {item.designation}
                            </p>
                          </div>
                        </div>
                        <span class="shrink-0 text-xs font-medium px-2 py-1 rounded-md bg-[#4285F4]/15 text-[#8ab4f8]">
                          {item.source ?? "Google"}
                        </span>
                      </div>
                      <div
                        class="text-amber-400 text-lg tracking-wide mb-3"
                        itemprop="reviewRating"
                        itemscope
                        itemtype="https://schema.org/Rating"
                        aria-label={`${rating} out of 5 stars`}
                      >
                        <meta itemprop="ratingValue" content={String(rating)} />
                        <meta itemprop="bestRating" content="5" />
                        {stars(rating)}
                      </div>
                      {
                        item.date_published && (
                          <meta
                            itemprop="datePublished"
                            content={item.date_published}
                          />
                        )
                      }
                      <blockquote
                        class="text-text-light text-base leading-relaxed flex-1"
                        itemprop="reviewBody"
                      >
                        “{item.content}”
                      </blockquote>
                      <a
                        href={href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-5 inline-flex items-center gap-2 text-sm text-primary-light hover:underline"
                        itemprop="url"
                      >
                        Open Google review profile
                        <span aria-hidden="true">↗</span>
                      </a>
                    </article>
                  );
                })
              }
            </div>
            <p class="mt-6 text-center text-sm text-text/70">
              Reviews sourced from{" "}
              <a
                href={mapsUrl}
                class="underline hover:text-white"
                target="_blank"
                rel="noopener noreferrer"
              >
                Google Maps
              </a>
              . Each card links to the reviewer’s public Google contributions.
            </p>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .google-reviews-scroller {
    scrollbar-width: thin;
    scrollbar-color: rgba(147, 122, 255, 0.5) transparent;
  }
  .google-reviews-scroller::-webkit-scrollbar {
    height: 6px;
  }
  .google-reviews-scroller::-webkit-scrollbar-thumb {
    background: rgba(147, 122, 255, 0.45);
    border-radius: 999px;
  }
</style>
